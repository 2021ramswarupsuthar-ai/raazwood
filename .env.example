# Copy to .env.local and fill in. Never commit .env.local. Every variable the code reads is listed here.
# Optional services (SMS, email, WhatsApp, analytics, AI) can stay empty: the site works without them.

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PHONE=+91 00000 00000
NEXT_PUBLIC_WHATSAPP=910000000000        # digits only, with country code, no +
NEXT_PUBLIC_EMAIL=hello@raazwood.example
NEXT_PUBLIC_ADDRESS="Krishana Art Palace, Rajasthan, India"

# ---------- Database (PostgreSQL) ----------
# Local: `npm run db:up` (Docker) then use the two lines below. Production: your Neon pooled URL + direct URL.
DATABASE_URL=postgresql://raazwood:raazwood@localhost:5433/raazwood
DIRECT_URL=postgresql://raazwood:raazwood@localhost:5433/raazwood

# ---------- Tax / shipping (confirm with your CA) ----------
SELLER_STATE_CODE=RJ
SELLER_GSTIN=
DEFAULT_GST_RATE=18
FREE_SHIPPING_ABOVE_PAISE=0               # 0 = off. Example: 5000000 = Rs 50,000 (goods value after coupon)
ORDER_EXPIRY_MINUTES=30                   # Razorpay orders: stock is reserved this long
# SERVICEABLE_STATES=TS,AP,KA,TN,KL       # default for states without a row in Admin > Delivery. Unset = everywhere

# ---------- Payments ----------
# PAYMENT_PROVIDER=razorpay               # razorpay | manual_upi. Unset: Razorpay if its keys are set, else manual UPI if UPI_VPA is set
RAZORPAY_KEY_ID=                          # use TEST keys until launch
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Manual UPI fallback (README section 6, option B): customer pays your UPI ID and types the UTR, admin verifies
UPI_VPA=                                  # e.g. yourshop@okhdfcbank
UPI_PAYEE_NAME=Krishana Art Palace
MANUAL_UPI_EXPIRY_HOURS=24                # unpaid manual UPI orders release stock after this

# ---------- Admin and customer sessions ----------
ADMIN_JWT_SECRET=                         # min 32 random chars: openssl rand -base64 48
CUSTOMER_JWT_SECRET=                      # optional, min 32 chars. Falls back to ADMIN_JWT_SECRET
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=                      # min 10 chars, used only by `npm run db:seed`
CRON_SECRET=                              # protects /api/cron/expire-orders

# ---------- Messages (all optional) ----------
# Without MSG91 in development, login codes and order messages are printed in the server console and the
# login page shows the code. In production customer login needs MSG91 (DLT-registered OTP template).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=                    # DLT-approved template containing ##OTP##
MSG91_ORDER_FLOW_ID=                      # optional Flow template for order updates (vars: name, order, status)
RESEND_API_KEY=                           # order emails via resend.com
EMAIL_FROM=                               # e.g. "Raazwood <orders@yourdomain.in>" (domain verified in Resend)
WHATSAPP_TOKEN=                           # WhatsApp Cloud API (Meta) permanent token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=                  # approved template, body params: {{1}} name {{2}} order {{3}} status {{4}} link
WHATSAPP_TEMPLATE_LANG=en

# ---------- Analytics (optional, loads only after cookie consent) ----------
NEXT_PUBLIC_GA_ID=                        # G-XXXXXXX

# ---------- AI assistant (free tier) ----------
GEMINI_API_KEY=                           # free key from Google AI Studio
ASSISTANT_MODEL=                          # pick a free-tier model from Google's current list
ASSISTANT_FALLBACK_BASE_URL=              # optional OpenAI-compatible endpoint (Groq, OpenRouter...)
ASSISTANT_FALLBACK_API_KEY=
ASSISTANT_FALLBACK_MODEL=
ASSISTANT_DAILY_REQUEST_CAP=400           # after this many AI calls per day (per instance) the rule-based mode answers

# ---------- Storefront text (optional; shown only when set, so nothing is promised by default) ----------
# NEXT_PUBLIC_OFFER_BANNER="Festive sale: use code SAMPLE10 for 10% off"   # top announcement bar
# NEXT_PUBLIC_WARRANTY_TEXT="10-year warranty against termite and borer"     # trust strip + product page
# NEXT_PUBLIC_RETURNS_TEXT="7-day replacement for transit damage"            # trust strip + product page
