# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PHONE=+91 00000 00000
NEXT_PUBLIC_WHATSAPP=910000000000        # digits only, with country code, no +
NEXT_PUBLIC_EMAIL=hello@raazwood.example
NEXT_PUBLIC_ADDRESS="Krishana Art Palace, Rajasthan, India"

# ---------- Database (Neon Postgres) ----------
DATABASE_URL=
DIRECT_URL=

# ---------- Tax / shipping (confirm with your CA) ----------
SELLER_STATE_CODE=RJ
SELLER_GSTIN=
DEFAULT_GST_RATE=18
FREE_SHIPPING_ABOVE_PAISE=0               # 0 = off. Example: 5000000 = Rs 50,000
ORDER_EXPIRY_MINUTES=30
# SERVICEABLE_STATES=TS,AP,KA,TN,KL       # leave unset to deliver everywhere

# ---------- Razorpay (use TEST keys until launch) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=              # same as RAZORPAY_KEY_ID (public key id only)

# ---------- Admin ----------
ADMIN_JWT_SECRET=                         # min 32 random chars: openssl rand -base64 48
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=                      # used only by `npm run db:seed`
CRON_SECRET=                              # protects /api/cron/expire-orders

# ---------- AI assistant (free tier) ----------
GEMINI_API_KEY=                           # free key from Google AI Studio
ASSISTANT_MODEL=                          # pick a free-tier model from Google's current list
ASSISTANT_FALLBACK_BASE_URL=              # optional OpenAI-compatible endpoint (Groq, OpenRouter...)
ASSISTANT_FALLBACK_API_KEY=
ASSISTANT_FALLBACK_MODEL=
